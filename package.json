{
  "name": "supercell",
  "version": "1.0.0",
  "license": "MIT",
  "description": "firebase practice application with GitHub Actions <3",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev src/app --webpack",
    "preserve": "npm run build-public && npm run build-functions && npm run build-app && npm run copy-deps && npm run install-deps",
    "serve": "cross-env NODE_ENV=production firebase serve",
    "deploy": "firebase deploy",
    "clean": "node scripts/files.cjs clean",
    "build-app": "node scripts/build-app.cjs",
    "build-public": "node scripts/files.cjs public",
    "build-functions": "tsc --project src/functions",
    "lint-app": "eslint src/app --max-warnings=0",
    "typecheck-app": "tsc --project src/app",
    "lint-functions": "eslint src/functions --max-warnings=0",
    "copy-deps": "node scripts/files.cjs deps",
    "install-deps": "npm ci --prefix dist/functions --omit=dev",
    "lint": "npm run lint-app && npm run lint-functions && npm run lint-scripts",
    "lint-scripts": "eslint scripts *.cjs --max-warnings=0",
    "test:database": "npm run build-functions && firebase emulators:exec --only database --project demo-supercell \"node scripts/test-database-rules.cjs\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-firebase-hooks": "^5.1.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "firebase-tools": "^15.30.0",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
